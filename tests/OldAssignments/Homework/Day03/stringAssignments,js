// =================================================
// ASSIGNMENT 1: FIND THE LAST WORD AND ITS LENGTH
// =================================================
//
// Steps:
// 1. Store the sentence.
// 2. Split the sentence into words.
// 3. Get the last word using array length.
// 4. Find the length of the last word.
// =================================================

console.log("Assignment 1\n");

let s = "Hello World";

// split(" ") → converts string into an array of words
let strArr = s.split(" ");

console.log("The string is " + strArr);

// length - 1 → index of the last element
let lastWord = strArr[strArr.length - 1];

console.log(`The last word is ${lastWord}`);
console.log(`Length of the last word is ${lastWord.length}`);


// =================================================
// ASSIGNMENT 2: TRIM AND FIND THE LAST WORD
// =================================================
//
// trim() → removes spaces from the beginning and end.
//
// Steps:
// 1. Store a string containing extra spaces.
// 2. Remove leading/trailing spaces using trim().
// 3. Split the string into words.
// 4. Get the last word.
// =================================================

console.log("\nAssignment 2\n");

let s1 = " fly me to the moon ";

let beforetrim = s1;
console.log(`Before Trim is ${beforetrim}`);

// trim() → removes spaces from beginning and end
let aftertrim = beforetrim.trim();

console.log(`After Trim is ${aftertrim}`);

// Split the trimmed string into words
let wordsplit = aftertrim.split(" ");

console.log(`Split Word now is ${wordsplit}`);

// Get the last word from the array
let lastWordnow = wordsplit[wordsplit.length - 1];

console.log(`The last word is ${lastWordnow}`);


// =================================================
// ASSIGNMENT 3: CHECK IF TWO STRINGS ARE ANAGRAMS
// =================================================
//
// Anagram:
// Two strings contain the same characters,
// regardless of their order.
//
// Example:
// "listen" → "silent"
//
// Steps:
// 1. Convert both strings to lowercase.
// 2. Remove spaces.
// 3. Split into individual characters.
// 4. Sort the characters.
// 5. Join them back into strings.
// 6. Compare the strings.
// =================================================

console.log("\nAssignment 3\n");

function isAnagram(str1, str2) {

    // Convert to lowercase and remove spaces
    str1 = str1.toLowerCase().replaceAll(" ", "");
    str2 = str2.toLowerCase().replaceAll(" ", "");

    // Convert to characters → sort → join back
    str1 = str1.split("").sort().join("");
    str2 = str2.split("").sort().join("");

    // Print processed strings for comparison
    console.log(str1);
    console.log(str2);

    // If sorted strings are equal, they are anagrams
    if (str1 == str2)
        return "Anagram";
    else
        return "Not Anagram";
}


// Test the function with different string pairs
console.log(isAnagram("listen", "silent"));
console.log(isAnagram("hello", "world"));